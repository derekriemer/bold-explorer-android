CREATE TABLE collection_trail (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    collection_id INTEGER NOT NULL REFERENCES collection(id),
    trail_id INTEGER NOT NULL REFERENCES trail(id),
    created_at INTEGER NOT NULL
);

CREATE INDEX idx_collection_trail_collection ON collection_trail(collection_id);
CREATE INDEX idx_collection_trail_trail ON collection_trail(trail_id);

trailsForCollection:
SELECT t.* FROM trail AS t
INNER JOIN collection_trail AS ct ON ct.trail_id = t.id
WHERE ct.collection_id = :collectionId;

insert:
INSERT INTO collection_trail (collection_id, trail_id, created_at)
VALUES (:collectionId, :trailId, :createdAt);

delete:
DELETE FROM collection_trail
WHERE collection_id = :collectionId AND trail_id = :trailId;

deleteForTrail:
DELETE FROM collection_trail WHERE trail_id = :trailId;

deleteForCollection:
DELETE FROM collection_trail WHERE collection_id = :collectionId;
