CREATE TABLE waypoint (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    elev_m REAL,
    description TEXT,
    created_at INTEGER NOT NULL,
    kind TEXT NOT NULL DEFAULT 'waypoint',
    tentative INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_waypoint_lat_lon ON waypoint(lat, lon);

-- User-created waypoints only; track points excluded.
getAll:
SELECT * FROM waypoint WHERE kind = 'waypoint';

getById:
SELECT * FROM waypoint WHERE id = :id;

insert:
INSERT INTO waypoint (name, lat, lon, elev_m, description, created_at, kind, tentative)
VALUES (:name, :lat, :lon, :elevM, :description, :createdAt, :kind, :tentative);

lastInsertRowId:
SELECT last_insert_rowid();

updateFull:
UPDATE waypoint
SET name = :name,
    lat = :lat,
    lon = :lon,
    elev_m = :elevM,
    description = :description
WHERE id = :id;

remove:
DELETE FROM waypoint WHERE id = :id;

-- All points for a trail in order (waypoints + track points); used for trail following.
forTrail:
SELECT w.* FROM waypoint AS w
INNER JOIN trail_waypoint AS tw ON tw.waypoint_id = w.id
WHERE tw.trail_id = :trailId
ORDER BY tw.position;

-- Named waypoints for a trail, however they are attached; used in the trail editor UI.
--
-- Two ways to be attached since S5b: as a vertex of the geometry (a hand-built route), or as an
-- annotation projected onto it (anything attached to a recorded trail, including a waypoint marked
-- mid-walk). The user made one gesture for both and should see one list, so this unions them and
-- orders both by where they fall along the trail. A vertex at `position` is polyline vertex
-- `position - 1`, which is what makes the two sort keys comparable.
namedWaypointsForTrail:
SELECT w.*
FROM waypoint AS w
INNER JOIN (
    SELECT waypoint_id AS wid, (position - 1) * 1.0 AS along_seg, 0.0 AS along_off
    FROM trail_waypoint WHERE trail_id = :trailId
    UNION ALL
    SELECT waypoint_id AS wid, segment_index * 1.0 AS along_seg, offset_m AS along_off
    FROM trail_annotation WHERE trail_id = :trailId
) AS ord ON ord.wid = w.id
WHERE w.kind = 'waypoint'
ORDER BY ord.along_seg, ord.along_off;

-- Count of track points for a trail; cheap query for the summary line.
trackPointCountForTrail:
SELECT COUNT(*) FROM waypoint AS w
INNER JOIN trail_waypoint AS tw ON tw.waypoint_id = w.id
WHERE tw.trail_id = :trailId AND w.kind = 'track_point';

-- Track points only for a trail; only fetched when user explicitly requests them.
trackPointsForTrail:
SELECT w.* FROM waypoint AS w
INNER JOIN trail_waypoint AS tw ON tw.waypoint_id = w.id
WHERE tw.trail_id = :trailId AND w.kind = 'track_point'
ORDER BY tw.position;

-- Candidates for withDistanceFrom: anti-meridian crossing case (OR on lon)
waypointsInBboxCrossing:
SELECT * FROM waypoint
WHERE kind = 'waypoint'
  AND lat >= :latMin AND lat <= :latMax
  AND (lon >= :lonMin OR lon <= :lonMax)
ORDER BY abs(lat - :centerLat),
         CASE WHEN abs(lon - :centerLon) > 180
              THEN 360 - abs(lon - :centerLon)
              ELSE abs(lon - :centerLon) END
LIMIT :candidateLimit;

-- Candidates for withDistanceFrom: normal case (AND on lon)
waypointsInBboxNoCrossing:
SELECT * FROM waypoint
WHERE kind = 'waypoint'
  AND lat >= :latMin AND lat <= :latMax
  AND lon >= :lonMin AND lon <= :lonMax
ORDER BY abs(lat - :centerLat),
         CASE WHEN abs(lon - :centerLon) > 180
              THEN 360 - abs(lon - :centerLon)
              ELSE abs(lon - :centerLon) END
LIMIT :candidateLimit;
